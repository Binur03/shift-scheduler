# Flask
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret

# Admin dashboard login password (required — pick something strong)
ADMIN_PASSWORD=

# Business timezone for the 24-48h alert window (IANA name, e.g. America/Denver).
# Important on Cloud Run, whose clock is UTC.
APP_TIMEZONE=

# Admin session lifetime in seconds (default 12 hours)
SESSION_LIFETIME_SECONDS=43200
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# --- Database ---
# Cloud Run + Cloud SQL: set INSTANCE_CONNECTION_NAME and the app will use the
# Unix socket at /cloudsql/<name>. Locally, leave it blank and use TCP below.
INSTANCE_CONNECTION_NAME=
DB_USER=app
DB_PASS=
DB_NAME=shift_scheduler

# Local TCP (used only when INSTANCE_CONNECTION_NAME is empty)
DB_HOST=127.0.0.1
DB_PORT=3306

# Connection pool tuning (optional overrides)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Full DB URI override (skips all MySQL settings above).
# Handy for quick local runs: DATABASE_URL=sqlite:///local.db
DATABASE_URL=

# --- Twilio messaging (optional; messages are logged, not sent, when blank) ---
# Channel: "whatsapp" (needs Meta-approved sender + templates for production)
# or "sms" (plain texts from TWILIO_SMS_NUMBER — no template approval needed;
# fastest path to production).
MESSAGING_CHANNEL=whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sender in E.164, e.g. +14155238886 (sandbox number for testing)
TWILIO_WHATSAPP_NUMBER=
# SMS sender in E.164 (used when MESSAGING_CHANNEL=sms)
TWILIO_SMS_NUMBER=

# Approved Content Template SIDs (HX…) — required for production sending.
# When blank, messages fall back to free-form bodies (sandbox/dev only).
# See TWILIO_SETUP.md Part D for the template text to submit.
TWILIO_CONTENT_SID_INVITE=
TWILIO_CONTENT_SID_REMINDER=
TWILIO_CONTENT_SID_ALERT=

# Default country code for phone numbers entered without "+" (e.g. 303-555-0123)
DEFAULT_COUNTRY_CODE=1

# --- SMS check-in / check-out (inbound webhook: POST /webhooks/twilio/sms) ---
# Signatures are verified with TWILIO_AUTH_TOKEN against PUBLIC_BASE_URL, so
# PUBLIC_BASE_URL must be exactly the URL configured in the Twilio console.
# How early (minutes before scheduled start) a worker may text IN.
PUNCH_EARLY_MINUTES=60

# --- Vendor shift emails (SendGrid Inbound Parse -> POST /webhooks/email/<token>) ---
# Basic Auth credentials embedded in the SendGrid destination URL.
INBOUND_EMAIL_USERNAME=
INBOUND_EMAIL_PASSWORD=

# --- Alerts ---
# Admin's WhatsApp number (E.164) that receives understaffing alerts.
ADMIN_WHATSAPP_NUMBER=
# Shared secret Cloud Scheduler must send in the X-Tasks-Auth header.
CRON_SECRET=
# Understaffing alert window (hours before shift start). Default 24-48.
ALERT_WINDOW_MIN_HOURS=24
ALERT_WINDOW_MAX_HOURS=48
# Day-before worker reminder horizon (hours before shift start).
REMINDER_HOURS=24

# --- Observability (optional) ---
# Sentry DSN for error reporting; blank disables Sentry.
SENTRY_DSN=
LOG_LEVEL=INFO
