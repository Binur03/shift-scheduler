# Flask
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret

# Admin dashboard login password (required — pick something strong)
ADMIN_PASSWORD=

# Business timezone for the 24-48h alert window (IANA name, e.g. America/Denver).
# Important on Cloud Run, whose clock is UTC.
APP_TIMEZONE=

# Admin session lifetime in seconds (default 12 hours)
SESSION_LIFETIME_SECONDS=43200
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# --- Database ---
# Cloud Run + Cloud SQL: set INSTANCE_CONNECTION_NAME and the app will use the
# Unix socket at /cloudsql/<name>. Locally, leave it blank and use TCP below.
INSTANCE_CONNECTION_NAME=
DB_USER=app
DB_PASS=
DB_NAME=shift_scheduler

# Local TCP (used only when INSTANCE_CONNECTION_NAME is empty)
DB_HOST=127.0.0.1
DB_PORT=3306

# Connection pool tuning (optional overrides)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Full DB URI override (skips all MySQL settings above).
# Handy for quick local runs: DATABASE_URL=sqlite:///local.db
DATABASE_URL=

# --- Twilio WhatsApp (optional; messages are logged, not sent, when blank) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp sender in E.164, e.g. +14155238886 (sandbox number for testing)
TWILIO_WHATSAPP_NUMBER=

# --- Alerts ---
# Admin's WhatsApp number (E.164) that receives understaffing alerts.
ADMIN_WHATSAPP_NUMBER=
# Shared secret Cloud Scheduler must send in the X-Tasks-Auth header.
CRON_SECRET=
# Understaffing alert window (hours before shift start). Default 24-48.
ALERT_WINDOW_MIN_HOURS=24
ALERT_WINDOW_MAX_HOURS=48
